# Copy to .env and fill in. Blank values fall back to defaults.

# testnet (Sepolia, Solana devnet, BTC testnet, Spark regtest) | mainnet
NETWORK=testnet

# API server (local: `docker compose up -d` starts Postgres on 5433)
DATABASE_URL=postgres://buchki:buchki@127.0.0.1:5433/buchki
# The web app's origin (CORS, CSRF check, sign-in message). Production: web and API on the same site, e.g. wallet.x.com + api.x.com
WEB_ORIGIN=http://localhost:5173
PORT=4000

# WDK Indexer API keys (balances/history), picked by NETWORK
TEST_WDK_API_KEY=
LIVE_WDK_API_KEY=

# RPC overrides for the selected network (blank = public default from wallet-core/networks.ts)
ETH_RPC_URL=
SOLANA_RPC_URL=
BTC_BLOCKBOOK_URL=

# Fiat on/off-ramps (API only, never shipped to the browser)
MOONPAY_API_KEY=
MOONPAY_ENVIRONMENT=sandbox
TRANSAK_API_KEY=
TRANSAK_ENVIRONMENT=STAGING
