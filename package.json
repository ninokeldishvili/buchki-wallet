{
  "name": "buchki-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "smoke:api": "node --env-file-if-exists=.env scripts/api-smoke.ts",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b packages/wallet-core scripts apps/api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@tetherto/wdk-wallet": "1.0.0-beta.25",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.26"
  }
}
